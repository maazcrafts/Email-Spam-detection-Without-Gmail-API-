# Google Cloud OAuth 2.0
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# Long random secret used to encrypt the Gmail refresh-token cookie
GMAIL_SESSION_SECRET=generate-a-long-random-secret

# Must exactly match the redirect URI registered in Google Cloud.
# Example:
# https://your-project.vercel.app/api/gmail/callback
GMAIL_REDIRECT_URI=https://your-project.vercel.app/api/gmail/callback
